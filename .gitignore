# Environment variables / secrets
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/

# VS Code
.vscode/

# Database
*.db
*.sqlite
*.sqlite3

# Generated model files
*.pkl
*.joblib

# Generated outputs
output/
*.log

# Python build files
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Temporary files
*.tmp
*.temp

# Application logs
logs/